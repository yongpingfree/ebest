APP_NAME="eBest VMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vms.example.com
APP_LOCALE=zh
APP_FALLBACK_LOCALE=zh
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vms
# DB_USERNAME=vms
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Email (vendor confirmation code). Use "log" for testing: the code is written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="vms@ebest.example"
MAIL_FROM_NAME="eBest VMS"

# Image storage: "public" (local, for testing) or "s3" (production, same as OMS: images/<uuid>-<file>, public-read, served by CDN)
VMS_IMAGE_DISK=s3
VMS_IMAGE_CDN_HOST=cdn.minimall.donkibuy.com
# 可选:CloudFront 分配 id,配置后删除图片会同时让 CDN 缓存失效
VMS_CDN_DISTRIBUTION_ID=
# 以下两项填 base64 编码值:echo -n '<值>' | base64
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# First eBest staff account created by "php artisan db:seed"
VMS_STAFF_EMAIL=admin@ebest.example
# 新供应商提交资料后通知审核的邮箱(逗号分隔);不填则通知全部启用的管理员账号
VMS_STAFF_NOTIFY_EMAIL=
VMS_STAFF_PASSWORD=

# All VMS tables are prefixed with vms_ (including sessions, cache, jobs, migrations)
DB_PREFIX=vms_
