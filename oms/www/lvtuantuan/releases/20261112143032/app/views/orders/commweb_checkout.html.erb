<script src="https://paymentgateway.commbank.com.au/checkout/version/60/checkout.js" data-error="errorCallback" data-cancel="cancelCallback"></script>

<script type="text/javascript">
  function errorCallback(error) {
    if (window.ReactNativeWebView) {
      window.ReactNativeWebView.postMessage(JSON.stringify({ type: 'paymentError', params: error }));
    } else {
      location.href = '/orders/commweb_failure?locale=<%= params[:locale] %>'
    }
  }

  function cancelCallback() {
    if (window.ReactNativeWebView) {
      window.ReactNativeWebView.postMessage(JSON.stringify({ type: 'paymentCancel' }));
    } else {
      location.href = '/orders/commweb_failure?locale=<%= params[:locale] %>'
    }
  }

  function pay() {
    var config = JSON.parse('<%= raw(@checkout_config.to_json) %>');

    Checkout.configure(config);
    Checkout.showPaymentPage();
  }

  $(function() {
    pay();
  })
</script>
